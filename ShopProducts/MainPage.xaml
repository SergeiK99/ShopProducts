<Page
    x:Class="ShopProducts.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShopProducts"
    xmlns:vm="using:ShopProducts.ViewModels"
    xmlns:models="using:ShopProducts.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="12">
        <TextBlock Text="Тестовый текст - если вы видите это, значит XAML работает" 
                   Foreground="Red" 
                   FontSize="20" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top" 
                   Margin="0,0,0,20"/>
        
        <ScrollViewer Margin="0,50,0,0">
            <StackPanel x:Name="ProductsPanel">
                <!-- Продукты будут добавляться сюда программно -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
